 14 урок Методы __add__, __sub__, __muil__, __truediv__ (Арифметические операции)

 __add__ - сложение
 __sub__ - вычитание
 __muil__ - умножение
 __truediv__ - деление

Пример:

class Clock:

    def __init__(self, hours):
        self.hours = hours

    def __str__(self):
        return f"{self.hours} ч."

    # 1. Сложение (+)
    def __add__(self, other):
        if isinstance(other, Clock):
            return Clock(self.hours + other.hours)
        return Clock(self.hours + other)

    # 2. Вычитание (-)
    def __sub__(self, other):
        if isinstance(other, Clock):
            return Clock(self.hours - other.hours)
        return Clock(self.hours - other)

    # 3. Умножение (*)
    def __mul__(self, other):
        return Clock(self.hours * other)

    # 4. Деление (/)
    def __truediv__(self, other):
        return Clock(self.hours / other)


# --- Проверяем работу всех методов ---

c1 = Clock(10)
c2 = Clock(4)

print(c1 + c2)  # Сработает __add__ -> 14 ч.
print(c1 - c2)  # Сработает __sub__ -> 6 ч.
print(c1 * 2)  # Сработает __mul__ -> 20 ч.
print(c1 / 2)  # Сработает __truediv__ -> 5.0 ч.